{
  "meta": {
    "name": "Bookstore Premium",
    "version": "1.0.0",
    "designLanguage": "Warm editorial luxury",
    "referencePriority": "attached-image"
  },
  "colors": {
    "background": "#FFFCF8",
    "backgroundWarm": "#F5EBDD",
    "surface": "#FFFFFF",
    "surfaceWarm": "#FAF4EB",
    "surfaceMuted": "#F4F0EA",
    "primary": "#C99442",
    "primaryDark": "#A76E24",
    "primaryLight": "#E6BF82",
    "accentSoft": "#F9EEDC",
    "textPrimary": "#191C24",
    "textSecondary": "#777A80",
    "textMuted": "#A4A4A8",
    "border": "#EAE5DD",
    "divider": "#EEEAE4",
    "success": "#39815B",
    "error": "#CC4545",
    "warning": "#D99B26",
    "rating": "#F5AE21",
    "white": "#FFFFFF",
    "black": "#000000"
