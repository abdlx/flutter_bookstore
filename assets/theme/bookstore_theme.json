  "typography": {
    "families": {
      "display": "Cormorant Garamond",
      "body": "Inter"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizes": {
      "caption": 11,
      "small": 12,
      "bodySmall": 13,
      "body": 14,
      "bodyLarge": 16,
      "subtitle": 18,
      "sectionTitle": 20,
      "title": 26,
      "display": 34
    },
    "lineHeight": {
      "compact": 1.15,
      "normal": 1.4,
      "comfortable": 1.6
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "base": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "section": 36
  },
  "radius": {
    "small": 8,
    "medium": 12,
    "large": 16,
    "card": 18,
    "input": 16,
    "button": 15,
    "pill": 999
  },
  "elevation": {
    "card": {
      "blur": 20,
      "spread": 0,
      "offsetY": 6,
      "opacity": 0.05
    },
    "floating": {
      "blur": 28,
      "spread": 0,
      "offsetY": 12,
      "opacity": 0.1
    }
  },
  "components": {
    "bookCover": {
      "aspectRatio": 0.68,
      "radius": 9
