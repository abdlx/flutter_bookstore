    "bottomNavigation": {
      "height": 72,
      "itemCount": 5
    },
    "content": {
      "horizontalPadding": 20,
      "sectionSpacing": 28
    }
  },
  "motion": {
    "fastMs": 150,
    "normalMs": 250,
    "slowMs": 350,
    "curve": "easeInOut"
  }
